<https://data.vlaanderen.be/id/organisatie/OVO008642>
  a org:Organization ;
  skos:prefLabel "Team Media en film"@nl ;
  skos:altLabel "Med.&film"@nl ;
  dct:description "Het team Media en Film is verantwoordelijk voor de beleidsvoorbereiding en -uitvoering inzake media, met name audiovisuele en auditieve mediadiensten, hulp aan de geschreven pers, media-innovatie en mediawijsheid en het audiovisuele beleid, film en games incluis. Het team geeft daarnaast uitvoering aan het Mediadecreet en is verantwoordelijk voor het technische beleid inzake radiofrequenties die gebruikt worden voor omroep en voor de erkenning van radio-omroeporganisaties, de regionale televisieomroeporganisaties en de opvolging van de subsidiedossiers voor media. Het team staat in voor de dossierbehandeling van de taxshelters voor film en voor podiumkunsten. Ten slotte beheert het team het secretariaat voor de filmkeuring."@nl ;
  adms:status <http://data.vlaanderen.be/id/concept/organisatiestatus/actief> ;
  adms:identifier
  [
    a adms:Identifier ;
    skos:notation "OVO008642" ;
    dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949> ;
    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2018-01-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/c85c357d-74b6-c047-2be2-858e18404e67> ;
