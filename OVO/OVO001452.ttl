    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-04-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/39c7bc2c-75a5-42a3-b476-1ab6a3b5540d> ;
