    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2021-09-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/9df015fb-a711-a1bb-6caf-58c66f5d8632> ;
