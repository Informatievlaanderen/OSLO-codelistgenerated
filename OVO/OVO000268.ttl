    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-07-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/7a56312a-b317-4d9d-8a3e-cb8179a25124> ;
