    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-04-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/e6dbf307-7577-4675-852a-c5a4f342354e> ;
