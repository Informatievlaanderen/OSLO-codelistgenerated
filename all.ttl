@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/Energiescan>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Meting van de pandgebonden energetische waarden op een bepaald moment in tijd." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Energiescan" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/FinancieelAdvies>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Informatie op maat omtrent de specifieke Leningen of Premies waarvoor een klant in aanmerking komt." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Financieel advies" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/KleinAdvies>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Restcategorie - bv. interpretatie van bepaalde energie-specifieke terminologie zoals zonnekaart, thermoscan" ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "KleinAdvies" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/RenovatieAdvies>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Tips en advies op maat omtrent mogelijke aanpassingen aan het pand met als doel de huidige staat te verbeteren en zo energie te besparen." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Renovatie-advies" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/TechnischAdvies>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Advies op maat omtrent specifieke isolatiematerialen, groendak, warmtepomp en PV-panelen, riolering en hergebruik van materialen." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Technisch advies" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/VergelijkingEnergiefactuurEnLeveranciers>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "inschatting van de beste match tussen de klant en de energie-aanbieders, op basis van een toetsing van verschillende parameters." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "VergelijkingEnergiefactuurEnLeveranciers" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/BegeleidenPremieaanvraag>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Persoonlijke ondersteuning bij het beroep op financiële ondersteuning na afloop van de werken." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "BegeleidenPremieaanvraag" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/BegeleidenRenovatieproject>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Administratieve ondersteuning bij het uitvoeren van een vernieuwing of aanpassing van een pand met oog op het verbeteren van de energetische waarden." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "BegeleidenRenovatieproject" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/BegeleidingLeningaanvraag>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Persoonlijke ondersteuning bij het beroep op financiële ondersteuning voor of tijdens de werken, tegen een bepaalde rentevoet en een bepaalde terugbetalingstermijn." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "BegeleidenLeningaanvraag" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/COMeting>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Meting van de pandgebonden koolmonoxide-waarde op een bepaald moment in tijd." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "CO-meting" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/OnderhoudVerwarmingsinstallatie>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Persoonlijke ondersteuning bij de verzorging en voorbereiding op controle van warmtebronnen in een pand." ;
