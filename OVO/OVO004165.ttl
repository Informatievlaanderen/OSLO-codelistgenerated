    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2017-04-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/6abc62e2-7f01-7b99-1cbb-a206e7e5e16b> ;
