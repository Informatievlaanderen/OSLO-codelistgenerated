    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-12-18"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/5f2232f4-fcde-4b39-99db-74d6a1cbc6bd> ;
