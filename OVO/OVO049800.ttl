    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2021-10-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/a82ac496-52d7-5dd5-f903-4372ab7a62ba> ;
