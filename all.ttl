@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/(Sociale)Huuraangelegenheid>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Tips en advies omtrent alle huuractiviteiten, van zowel standpunt van de huurder als verhuurder. Kan ook voorkomen in de vorm van ondersteuning op maat omtrent het opstellen van huurcontracten, maar ook onderzoek naar discriminatie op de huurmarkt." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "(Sociale)Huuraangelegendheid" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/Energiescan>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Tips en advies over verwarming, verlichting, huishoudtoestellen en waar mogelijk energiebesparende maatregelen." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Energiescan" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/FinancieelAdvies>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Informatie op maat omtrent de specifieke financiële ondersteuningsmiddelen waarvoor een klant in aanmerking komt." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Financieel advies" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/OnderhoudVerwarmingsinstallatie>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Ondersteuning bij de verzorging en voorbereiding op controle van warmtebronnen in een pand." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "OnderhoudVerwarmingsinstallatie" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/RenovatieAdvies>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Tips en advies op maat omtrent mogelijke aanpassingen (zoals isolatie, groendak, warmtepomp, PV-panelen, riolering en verder hergebruik van materialen) aan het pand met als doel de huidige staat te verbeteren en zo energie te besparen." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Renovatie-advies" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/AdviesverleningType/VergelijkingEnergiefactuurEnLeveranciers>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Inschatting van de beste match tussen de klant en de energie-aanbieders, op basis van een toetsing van verschillende parameters." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "VergelijkingEnergiefactuurEnLeveranciers" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/(Sociale)Huuraangelegenheden>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Persoonlijke ondersteuning omtrent alle huuractiviteiten, in het merendeel van de gevallen voor de verhuurder, maar dit is geen limitatie. Voorbeelden zijn: de inschrijving in het CIR (Centraal InschrijvingsRegister), bijstand bij bemiddeling, ..." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "(Sociale)Huuraangelegenheden" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/Leningaanvraag>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Persoonlijke ondersteuning bij de aanvraag van een financieel geldbedrag, tegen een bepaalde rentevoet en een bepaalde terugbetalingstermijn." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Leningaanvraag" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/Premieaanvraag>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Persoonlijke ondersteuning bij het beroep op financiële ondersteuning voor het doorvoeren van een verandering." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Premieaanvraag" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/BegeleidingType/Renovatieproject>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Administratieve, organisatorische en technische ndersteuning bij het uitvoeren van een vernieuwing of aanpassing van een gebouw met oog op het verbeteren van de energetische waarden." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Renovatieproject" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/BegeleidingType> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/(Sociale)Huuraangelegenheden>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Generieke informatie omtrent alle huuractiviteiten, van zowel standpunt van de huurder als verhuurder." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "(Sociale)Huuraangelegenheden" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/BasisWoonkwaliteit>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Basisuitleg met betrekking tot het gedrag van de bewoner en bijbehorende algemene gedragsmaatregelen ter verbetering van het pand, alsook over woongerelateerde onderwerpen met betrekking op veiligheid, gezondheid en woonkwaliteit, zoals verwaarlozing en leegstand." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Basis Woonkwaliteit" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/Doorverwijzing>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Doorsturen naar een gespecialiseerde dienst, binnen of buiten het energiehuis." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Doorverwijzing" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/Energie>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Basisuitleg met betrekking tot verbruik, efficiëntie, isolatie, hernieuwbare energie, restwarmte, ventilatie of andere mogelijkheden om het gebouw zuiniger te maken." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Energie" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/Klimaatadaptatie>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Basisuitleg over maatregelen, die inspelen op het aanpassen van de woning aan de huidige en toekomstige klimaatverandering." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Klimaatadaptatie" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/Lening>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Basisuitleg over de verstrekking van geldbedragen tegen bepaalde rentevoet en op een bepaalde termijn " ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Lening" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/concept/InformatievoorzieningThema/Premie>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Basisuitleg over het aanbod aan financiële vergoedingen voor het doorvoeren van een verandering." ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Premie" ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema> .

<https://data.vlaanderen.be/id/conceptscheme/AdviesverleningType>
    a <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Codelijst voor type van adviesverlening." ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Conceptscheme type van adviesverlening" .

<https://data.vlaanderen.be/id/conceptscheme/BegeleidingType>
    a <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Codelijst voor type van begeleiding." ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Conceptscheme type van begeleiding" .

<https://data.vlaanderen.be/id/conceptscheme/InformatievoorzieningThema>
    a <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Codelijst voor type van informatievoorziening." ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Conceptscheme type van informatievoorziening" .

