<https://data.vlaanderen.be/id/organisatie/OVO001450>
  a org:Organization ;
  skos:prefLabel "Sport Vlaanderen Waregem"@nl ;
  skos:altLabel "SV Waregem"@nl ;
  dct:description "Sport Vlaanderen Waregem ligt pal naast de befaamde Waregemse renbaan. Het is dus niet verwonderlijk dat het centrum helemaal in het teken van de paardensport staat. Het complex is een modern ruitersportcentrum waar de meeste ruitersportdisciplines kunnen worden beoefend: er is een indoormanege met tribune voor 150 personen en een overdekte paddock. Buiten vind je de all weather arena, een renbaan en een hindernissenpiste."@nl ;
  adms:status <http://data.vlaanderen.be/id/concept/organisatiestatus/actief> ;
  adms:identifier
  [
    a adms:Identifier ;
    skos:notation "OVO001450" ;
    dct:creator <https://data.vlaanderen.be/id/organisatie/OVO002949> ;
    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-04-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/93d721c0-a663-4bb2-99b8-3588d44aaf14> ;
