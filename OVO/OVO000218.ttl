    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2014-01-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/6ece7b40-0546-4937-9c68-cb1a6fa83b45> ;
