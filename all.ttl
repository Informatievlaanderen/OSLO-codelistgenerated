@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://data.vlaanderen.be/id/concept/Rooilijntype/GrensOpenbareWeg>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Elke weg die voor het openbaar verkeer openstaat, ook als de bedding ervan een private eigendom is. Een weg omvat niet enkel de (rij)baan maar ook al haar aanhorigheden."@nl ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/Rooilijntype> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "GrensOpenbareWeg"@nl ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/Rooilijntype> .

<https://data.vlaanderen.be/id/concept/Rooilijntype/HuidigeRooilijn>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "De rooilijn, vastgelegd in een rooilijnplan, die de huidige grens tussen de openbare weg en de aangelande eigendommen weergeeft."@nl ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/Rooilijntype> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "HuidigeRooilijn"@nl ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/Rooilijntype> .

<https://data.vlaanderen.be/id/concept/Rooilijntype/ToekomstigeRooilijn>
    a <http://www.w3.org/2004/02/skos/core#Concept> ;
    <http://www.w3.org/2004/02/skos/core#definition> "De rooilijn, vastgelegd in een rooilijnplan, die de toekomstige, nog te realiseren grens tussen de openbare weg en de aangelande eigendommen aangeeft."@nl ;
    <http://www.w3.org/2004/02/skos/core#inscheme> <https://data.vlaanderen.be/id/conceptscheme/Rooilijntype> ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "ToekomstigeRooilijn"@nl ;
    <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://data.vlaanderen.be/id/conceptscheme/Rooilijntype> .

<https://data.vlaanderen.be/id/conceptscheme/Rooilijntype>
    a <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    <http://www.w3.org/2004/02/skos/core#definition> "Codelijst voor type van rooilijnen."@nl ;
    <http://www.w3.org/2004/02/skos/core#prefLabel> "Conceptscheme type van rooilijnen."@nl .

