<https://data.vlaanderen.be/id/organisatie/OVO053619>
  a org:Organization ;
  skos:prefLabel "Stowarzyszenie Artystyczne Muzyka Centrum"@nl ;
  dct:description "Stowarzyszenie Artystyczne Muzyka Centrum staat voor Artistieke Vereniging Muziekcentrum. Het is een vereniging van uitvoerders van hedendaagse muziek uit Krakau, Polen. De vereniging organiseert concerten van hedendaagse muziek van verschillende stijlen, alsook het Audio Art Festival, het Pomosty festival en internationale workshops voor hedendaagse muziek."@nl ;
  adms:status <http://data.vlaanderen.be/id/concept/organisatiestatus/actief> ;
