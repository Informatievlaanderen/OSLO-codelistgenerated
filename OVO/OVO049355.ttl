    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2021-09-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/6ce3f874-248b-6e81-802a-9e1c14b4f937> ;
