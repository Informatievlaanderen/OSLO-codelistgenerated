    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-04-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/73bb84b8-faf1-4e85-8bec-3545166116b0> ;
