    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2018-01-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/c70114ec-477e-ac96-3b4c-63ee11b7fdd9> ;
