    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2006-04-01"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/38693bfe-2d05-426f-88c4-462ba5875b58> ;
