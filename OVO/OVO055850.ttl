    adms:schemaAgency "Digitaal Vlaanderen"@nl ;
    dct:issued "2025-12-09"^^xsd:date
  ] ;
  rdfs:seeAlso <https://wegwijs.vlaanderen.be/#/organisations/fbc2cb93-38c6-3308-1522-bab5ee2e1b12> ;
